App(
    appid="mobib",
    name="MOBIB",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="mobib_app_main",
    requires=["gui", "notification", "dialogs", "storage", "nfc"],
    stack_size=4 * 1024,
    fap_icon="icons/mobib_10px.png",
    fap_category="NFC",
    fap_author="i12bp8",
    fap_version="0.1",
    fap_description="Read and explore Belgian MOBIB transit cards (Calypso).",
    sources=[
        "application/mobib_app.c",
        "application/calypso/calypso.c",
        "application/calypso/calypso_tlv.c",
        "application/calypso/calypso_fci.c",
        "application/calypso/calypso_env.c",
        "application/calypso/calypso_date.c",
        "application/calypso/calypso_event.c",
        "application/calypso/calypso_stations.c",
        "application/calypso/calypso_bus.c",
        "application/calypso/calypso_contract.c",
        "application/calypso/calypso_sfi.c",
        "application/calypso/calypso_holder.c",
        "application/nfc/mobib_nfc.c",
        "application/storage/mobib_storage.c",
        "application/ui/mobib_format.c",
        "application/scenes/scene_start.c",
        "application/scenes/scene_scan.c",
        "application/scenes/scene_dumps.c",
        "application/scenes/scene_card.c",
        "application/scenes/scene_card_section.c",
        "application/scenes/scene_about.c",
    ],
